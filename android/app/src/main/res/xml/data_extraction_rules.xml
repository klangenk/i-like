<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and phone-to-phone transfer include only the
     folder the app fills when the user turns backup on (BackupService). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="ilike_backup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="ilike_backup/" />
    </device-transfer>
</data-extraction-rules>
